{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "orca-agent-plugins": {
      "source": { "source": "directory", "path": "./config/agent-plugins" }
    }
  },
  "enabledPlugins": {
    "orca-typescript@orca-agent-plugins": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-sandboxed-tests.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking tests run in the sandbox"
          }
        ]
      }
    ]
  }
}
