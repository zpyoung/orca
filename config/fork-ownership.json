{
  "features": [
    {
      "name": "worktree-groups",
      "purpose": "Lets a worktree join a project group independently of its repo's own group membership, so cross-repo worktrees can share a sidebar section.",
      "globs": ["**/fork-worktree-groups/**"]
    },
    {
      "name": "native-chat-relay",
      "purpose": "Reads and live-tails native-chat transcripts for an agent running on a plain ssh: host over the SSH relay, since the desktop process cannot see that host's disk.",
      "globs": ["**/fork-native-chat-relay/**", "docs/architecture/native-chat.md"]
    },
    {
      "name": "native-chat-coloring",
      "purpose": "Renders native-chat tool calls with category glyphs/dots and syntax-highlighted code blocks instead of monochrome text.",
      "globs": [
        "**/fork-native-chat-coloring/**",
        "src/renderer/src/assets/fork-native-chat-coloring.css"
      ]
    },
    {
      "name": "native-chat-width",
      "purpose": "Lets the user pick the reading-column width for every native-chat pane instead of a fixed max-width.",
      "globs": ["**/fork-native-chat-width/**"]
    }
  ],
